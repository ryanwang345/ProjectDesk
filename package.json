{
  "name": "projectdesk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ProjectDesk enterprise monorepo with React, Go, Cypress, and Kubernetes GitOps",
  "workspaces": [
    "apps/web",
    "apps/e2e"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "test:e2e": "npm run typecheck --workspace=apps/e2e",
    "clean": "rm -rf node_modules apps/web/node_modules apps/web/dist apps/e2e/node_modules"
  }
}
