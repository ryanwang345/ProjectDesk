# Non-secret Cypress settings. Local runs and the CronJob both read this file.
# For the Docker Compose app on this machine, use http://127.0.0.1:47291

E2E_BASE_URL=https://rwang.ingress.k8s-test.sf.vailsys.net
E2E_BROWSER=chrome
E2E_RETRIES=1
E2E_SPEC=
E2E_TAGS=
E2E_VIDEO=false
E2E_ENVIRONMENT=dev
E2E_KEEP_RUNS=20

# Leave these empty to disable the feature.
E2E_S3_BUCKET=
E2E_S3_PREFIX=project-desk-e2e
E2E_S3_ENDPOINT=
E2E_PUSHGATEWAY_URL=
